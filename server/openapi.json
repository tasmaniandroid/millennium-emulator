ses":{"200":{"description":"Successful result","content":{"application/json":{"schema":{}}}},"400":{"description":"Invalid request or machine state","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}}}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"space":{"type":"string","enum":["logical","physical"],"default":"physical"},"address":{"oneOf":[{"type":"integer","minimum":0,"maximum":1048575},{"type":"string","pattern":"^(0x[0-9a-fA-F]+|[0-9]+)$"}],"description":"Execution address"},"bbr":{"oneOf":[{"type":"integer","minimum":0,"maximum":255},{"type":"string","pattern":"^(0x[0-9a-fA-F]+|[0-9]+)$"}],"description":"Optional bank register constraint"},"clear":{"type":"boolean"}}}}}}}},"/api/watchpoints":{"post":{"summary":"Add or clear memory/I/O watchpoints","description":"Read watchpoints include instruction fetches. Break occurs after the current instruction. I/O addresses are low 8 bits.","responses":{"200":{"description":"Successful result","content":{"application/json":{"schema":{}}}},"400":{"description":"Invalid request or machine state","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}}}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"space":{"type":"string","enum":["logical","physical"],"default":"physical"},"address":{"oneOf":[{"type":"integer","minimum":0,"maximum":1048575},{"type":"string","pattern":"^(0x[0-9a-fA-F]+|[0-9]+)$"}],"description":"Address or 8-bit port"},"length":{"oneOf":[{"type":"integer","minimum":0,"maximum":65536},{"type":"string","pattern":"^(0x[0-9a-fA-F]+|[0-9]+)$"}],"description":"Range length, default 1"},"kind":{"type":"string","enum":["read","write","in","out"]},"clear":{"type":"boolean"}}}}}}}},"/api/trace":{"post":{"summary":"Enable, clear and bound instruction trace","description":"","responses":{"200":{"description":"Successful result","content":{"application/json":{"schema":{}}}},"400":{"description":"Invalid request or machine state","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}}}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"enabled":{"type":"boolean"},"limit":{"oneOf":[{"type":"integer","minimum":0,"maximum":10000},{"type":"string","pattern":"^(0x[0-9a-fA-F]+|[0-9]+)$"}],"description":"Maximum retained rows, default 1000"},"clear":{"type":"boolean"}}}}}}},"get":{"summary":"Read retained instruction trace","description":"","responses":{"200":{"description":"Successful result","content":{"application/json":{"schema":{}}}},"400":{"description":"Invalid request or machine state","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}}}}}}}}},"/api/events":{"get":{"summary":"Read device/debug events","description":"Ring buffer of up to 2000 recent events; reset restarts IDs.","responses":{"200":{"description":"Successful result","content":{"application/json":{"schema":{}}}},"400":{"description":"Invalid request or machine state","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}}}}}}},"parameters":[{"name":"since","in":"query","schema":{"oneOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"string","pattern":"^(0x[0-9a-fA-F]+|[0-9]+)$"}],"description":"Exclusive event ID"}}]}},"/api/events/stream":{"get":{"summary":"Live state stream (Server-Sent Events)","description":"Default SSE event name is state, equivalent to GET /api/state. Opt in with display=1 for additional lightweight display events, emitted on VFD changes at up to 40 Hz. Display events contain display, displayHardware and view; full state events retain their normal cadence. Use view.session and increasing view.sequence to reject stale HTTP/SSE screen updates across polling, resets and reconnects.","responses":{"200":{"description":"Server-sent state events","content":{"text/event-stream":{"schema":{"type":"string"}}}},"400":{"description":"Invalid request or machine state","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}}}}}}},"parameters":[{"name":"display","in":"query","schema":{"type":"string","enum":["1"],"description":"Opt in to fast display-only events"}}]}},"/api/devices":{"post":{"summary":"Inject an input through simulated hardware","description":"handset: {offHook:boolean}; key: {key:\"0\"..\"9\"|\"*\"|\"#\"|\"language\"|\"next\"|\"volumeUp\"|\"volumeDown\"|\"release\"}; line: {lineConnected?,reversed?,ring?,dialTone?,busy?,answerTone?,carrier?} booleans; answer: {delayMs?:3000,method?:\"polarity\"|\"tone\"|\"both\"}; dtmf: {digit:\"0\"..\"9\"|\"*\"|\"#\"|\"A\"..\"D\",durationMs?:200}; sensor: {coverOpen?,cashboxRemoved?}; coin: {index:0..15}; card: {action:\"insert\",kind:\"magnetic\",track2:\";...?...\"} or {action:\"insert\",kind:\"smart\",hex:\"13..32 byte image\",writeProtected?:false} or {action:\"remove\"} or {action:\"position\",position:\"out\"|\"partial\"|\"seated\"}; telephony: {hex}; serial: {channel:0|1,hex}. Magnetic bits and sensors are delivered over simulated time; execute the firmware after injection. Smart-card acceptance is determined by firmware tables; no validation is bypassed.","responses":{"200":{"description":"Successful result","content":{"application/json":{"schema":{}}}},"400":{"description":"Invalid request or machine state","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}}}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"type":{"type":"string","enum":["handset","key","line","answer","dtmf","sensor","coin","card","telephony","serial"]},"data":{"type":"object"}}}}}}}},"/api/cards":{"get":{"summary":"Export reader state and the current smart-card image","description":"image is an array of bytes updated by contact debit/write-carry operations. The reader and image are included in full snapshots.","responses":{"200":{"description":"Successful result","content":{"application/json":{"schema":{}}}},"400":{"description":"Invalid request or machine state","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}}}}}}}}},"/api/ncc":{"get":{"summary":"Get the configured TCP target and transport counters","description":"","responses":{"200":{"description":"Successful result","content":{"application/json":{"schema":{}}}},"400":{"description":"Invalid request or machine state","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}}}}}}}},"post":{"summary":"Arm an existing NCC TCP target for firmware-initiated calls","description":"Configuring mode=connect arms the target without opening TCP. The first ASCI1 transmission with the modem relay seized opens the socket; initial bytes are buffered until connect. The socket closes when firmware releases the modem, resets, changes image or the target is disabled. Raw bytes pass unchanged, without NCC framing/checksum/validity checks. autoHandshake supplies analogue answer-tone/carrier before TCP opens, independently of network traffic. receiveDelayMs models inbound modem latency in simulated time, preventing zero-latency ACKs racing the firmware send-complete timer; it preserves continuous streams across TCP chunk boundaries. Incoming bytes preceding EOF drain through the UART before carrier is removed. GET /api/ncc reports armed, connecting, connected, pendingTransmitBytes, receiveDelayMs and error. TCP state is external to snapshots.","responses":{"200":{"description":"Successful result","content":{"application/json":{"schema":{}}}},"400":{"description":"Invalid request or machine state","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}}}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"mode":{"type":"string","enum":["connect","off"],"default":"connect"},"host":{"type":"string","default":"127.0.0.1"},"port":{"type":"integer","minimum":1,"maximum":65535,"default":16420},"autoHandshake":{"type":"boolean","default":true},"receiveDelayMs":{"type":"integer","minimum":0,"maximum":2000,"default":100}}}}}}}},"/api/inputs":{"get":{"summary":"Read recorded external inputs for replay","description":"","responses":{"200":{"description":"Successful result","content":{"application/json":{"schema":{}}}},"400":{"description":"Invalid request or machine state","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}}}}}}}}},"/api/replay":{"post":{"summary":"Schedule inputs at absolute simulated cycle positions","description":"Restore the baseline snapshot first, then schedule the recorded input sequence.","responses":{"200":{"description":"Successful result","content":{"application/json":{"schema":{}}}},"400":{"description":"Invalid request or machine state","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}}}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"events":{"type":"array","maxItems":10000,"items":{"type":"object","properties":{"cycle":{"oneOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"string","pattern":"^(0x[0-9a-fA-F]+|[0-9]+)$"}],"description":"Absolute cycle, not earlier than current time"},"type":{"type":"string"},"data":{"type":"object"}}}}}}}}}}},"/api/snapshots":{"get":{"summary":"List in-memory named snapshots","description":"","responses":{"200":{"description":"Successful result","content":{"application/json":{"schema":{}}}},"400":{"description":"Invalid request or machine state","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}}}}}}}},"post":{"summary":"Save a named s