{"openapi":"3.1.0","info":{"title":"Millennium Firmware Emulator","version":"0.2.0","description":"Local experimental Z180 execution/debug API. Firmware sources are attached at runtime (POST /api/attach) and loaded by absolute path; the server has no configured firmware roots. Select MTR1 (256 KiB ROM, 6.144 MHz) or MTR2 (1 MiB flash, separate RAM, 12.288 MHz). Timing is approximate. GET /api/boards lists wiring; /api/state reports board and capabilities. JSON errors use HTTP 400. Bind address is 127.0.0.1. No external dependencies."},"servers":[{"url":"/"}],"paths":{"/api/firmwares":{"get":{"summary":"List firmware images across attached sources","description":"Absolute path and size per image, deduplicated and sorted. Attach sources first with POST /api/attach.","responses":{"200":{"description":"Successful result","content":{"application/json":{"schema":{}}}},"400":{"description":"Invalid request or machine state","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}}}}}}}},"post":{"summary":"Upload a .bin firmware image","description":"Stored inside the server upload directory (temporary directory, auto-attached) without overwriting existing files. Maximum 1048576 bytes. The response path is absolute; load it with /api/load.","responses":{"200":{"description":"Successful result","content":{"application/json":{"schema":{}}}},"400":{"description":"Invalid request or machine state","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}}}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string"},"hex":{"type":"string","description":"Even-length hexadecimal bytes; whitespace permitted","examples":["c30002"]}}}}}}}},"/api/boards":{"get":{"summary":"List hardware profiles and wiring","description":"","responses":{"200":{"description":"Successful result","content":{"application/json":{"schema":{}}}},"400":{"description":"Invalid request or machine state","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}}}}}}}}},"/api/load":{"post":{"summary":"Load a ROM and optional symbol map","description":"path is an absolute filesystem path (or relative to the server working directory) to a firmware image; no firmware roots or aliases are configured. Auto honors a companion .build.json board only if its SHA-256 matches the image; otherwise it selects plain MTR2 above 256 KiB and MTR1 below. Explicit selections override metadata. Use mtr1-coin-basic for NPE1S01. Load responses report profileSource. Original files are never modified. Loads are cold resets. A companion .MAP next to the image is automatically discovered; verify its association.","responses":{"200":{"description":"Successful result","content":{"application/json":{"schema":{}}}},"400":{"description":"Invalid request or machine state","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}}}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"path":{"type":"string","description":"Absolute (or server-CWD-relative) path to the firmware image"},"mapPath":{"type":"string"},"board":{"type":"string","enum":["auto","mtr1","mtr1-coin-basic","mtr2"],"default":"auto"}}}}}}}},"/api/state":{"get":{"summary":"Get CPU, MMU, display, model capabilities and device state","description":"","responses":{"200":{"description":"Successful result","content":{"application/json":{"schema":{}}}},"400":{"description":"Invalid request or machine state","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}}}}}}}}},"/api/speed":{"get":{"summary":"Get realtime target factor and measured achieved factor","description":"","responses":{"200":{"description":"Successful result","content":{"application/json":{"schema":{}}}},"400":{"description":"Invalid request or machine state","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}}}}}}}},"post":{"summary":"Set realtime execution speed","description":"Applies while paused or running. A factor of 4 targets four simulated seconds per wall-clock second. Actual throughput is CPU-limited and reported separately as achievedFactor in /api/speed and /api/state.realtime. Short host execution batches keep TCP/HTTP responsive. Bounded /api/run and /api/step budgets are unchanged.","responses":{"200":{"description":"Successful result","content":{"application/json":{"schema":{}}}},"400":{"description":"Invalid request or machine state","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}}}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"factor":{"type":"number","minimum":0.1,"maximum":64,"default":4}}}}}}}},"/api/reset":{"post":{"summary":"Reset the CPU and peripherals","description":"Warm reset preserves RAM and EEPROM. Cold reset erases them. Execution must be paused.","responses":{"200":{"description":"Successful result","content":{"application/json":{"schema":{}}}},"400":{"description":"Invalid request or machine state","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}}}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"cold":{"type":"boolean","default":false}}}}}}}},"/api/pause":{"post":{"summary":"Pause continuous execution","description":"","responses":{"200":{"description":"Successful result","content":{"application/json":{"schema":{}}}},"400":{"description":"Invalid request or machine state","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}}}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{}}}}}}},"/api/resume":{"post":{"summary":"Resume continuous 